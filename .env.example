# Winners Sports Competition (WSC) Environment Configuration

# Next.js Public Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side operations only, never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Platform Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_HOST_INSTITUTION=Southern Delta University, Ozoro
NEXT_PUBLIC_OFFICIAL_BANK_NAME="First Bank of Nigeria"
NEXT_PUBLIC_OFFICIAL_ACCOUNT_NO="3123456789"
NEXT_PUBLIC_OFFICIAL_ACCOUNT_NAME="Winners Sports Competition Committee"
NEXT_PUBLIC_FOOTBALL_REG_FEE=10000
NEXT_PUBLIC_MARATHON_REG_FEE=3000
